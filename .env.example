# Dominus Payments — variáveis de ambiente
# Copie para .env e preencha. Nunca versione o .env. Nunca coloque credenciais reais neste arquivo.

# Ambiente lógico da aplicação: development | staging | production
APP_ENV=development

# URL pública do site (usada em metadados, Open Graph, sitemap e links absolutos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL 16+
DATABASE_URL=postgres://dominus:dominus@localhost:5432/dominus

# Provedor de pagamentos ativo. "none" = nenhum provedor conectado:
# toda operação de cobrança falha com PROVIDER_NOT_CONFIGURED e a interface
# mostra os métodos como indisponíveis. Ver docs/PROVIDERS.md.
PAYMENT_PROVIDER=none

# Dados institucionais exibidos no rodapé e nas páginas legais.
# Deixe em branco até ter os dados reais; a interface não inventa nada.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_CNPJ=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Marque como true somente depois da revisão jurídica dos termos e políticas.
NEXT_PUBLIC_LEGAL_REVIEWED=false
